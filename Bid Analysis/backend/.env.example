# The backend reads the repo-root .env (see ../.env.example for SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY, SUPABASE_SECRET_KEY).
# Backend-only settings; add them to the root .env:
SESSION_SECRET=                # REQUIRED in real use: any long random string. Signs the login cookie; if empty, sessions end on every restart.
# COOKIE_SECURE=true           # set when served over HTTPS
# SESSION_DAYS=7
# AUTH_MODE=enforce            # "enforce" (default) needs the signed cookie; "disabled" is dev only (X-Dev-User-Id header)
# BIDS_SOURCE=supabase         # or "mock" to read ../data/mock/bids.json
# CORS_ORIGINS=http://localhost:3000
