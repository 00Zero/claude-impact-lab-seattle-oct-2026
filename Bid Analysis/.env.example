# Copy to .env and fill in. Never commit .env.
SUPABASE_URL=https://jpqkpyfccgzayoyrudkb.supabase.co
# Safe in frontend code; can only read what RLS allows.
SUPABASE_PUBLISHABLE_KEY=
# Server-side scripts only (discovery, live search, lead handoff). Bypasses RLS.
SUPABASE_SECRET_KEY=

# Frontend (workstream A). Names only; put real values in .env.local (never committed).
# "fixtures" uses the isolated development fixtures and simulated services.
# "hybrid" shows the real open listings from Supabase (needs the two
#   NEXT_PUBLIC_SUPABASE_* values below); accounts and matching stay simulated.
# "live" calls the /api/v1 routes owned by workstream C (SRS section 13).
NEXT_PUBLIC_DATA_MODE=fixtures

# Used by hybrid mode. The publishable key is safe in the browser (RLS applies).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Base URL for the /api/v1 routes when they are served from another origin.
# Leave empty when the API is served by this Next.js app.
NEXT_PUBLIC_API_BASE_URL=

# Overrides Jon's scheduling link for "Book a call with Jon".
# Leave empty to use the default, https://calendly.com/jjcochran-nxvb.
NEXT_PUBLIC_BOOKING_URL=
