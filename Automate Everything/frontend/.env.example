# Copy to .env.local and paste your key. .env.local is git-ignored.
# Browser key: restrict it to http://localhost:5173/* and your demo URL in Google Cloud.
# Needs "Maps JavaScript API" and "Places API (New)" enabled.
VITE_GOOGLE_MAPS_API_KEY=

# Sign-in for business owners (Supabase Auth). The publishable key is safe in the browser;
# never put the secret/service-role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
