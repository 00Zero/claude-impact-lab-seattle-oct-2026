ANTHROPIC_API_KEY=
TAVILY_API_KEY=
# Optional paid Google Places lookup
GOOGLE_PLACES_API_KEY=
# Optional override; use a model available to your account
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional Square sales import; sandbox returns test data
SQUARE_ACCESS_TOKEN=
SQUARE_ENVIRONMENT=sandbox
# Optional; otherwise the first account location is used
SQUARE_LOCATION_ID=

# Optional Toast sales import
TOAST_CLIENT_ID=
TOAST_CLIENT_SECRET=
TOAST_RESTAURANT_GUID=
# Optional host/timezone overrides
# TOAST_API_HOST=https://ws-api.toasttab.com
# TOAST_TIMEZONE=America/Los_Angeles

# Supabase (monitor and saved reports; server-side only)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional email for reports and alerts: Resend, or SMTP
RESEND_API_KEY=
RESEND_FROM=
# SMTP_USER=
# SMTP_PASSWORD=
