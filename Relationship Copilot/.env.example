# Copy to .env.local and fill in. Never commit real values.
ANTHROPIC_API_KEY=
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
TAVILY_API_KEY=
# Invite code required to sign up
INVITE_CODE=

# Optional
# Models per stage. Extraction uses ANTHROPIC_MODEL; matching (the intro judge) uses
# ANTHROPIC_MATCH_MODEL, falling back to ANTHROPIC_MODEL; enrichment summaries and drafts use ANTHROPIC_FAST_MODEL.
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_MATCH_MODEL=claude-haiku-4-5
# ANTHROPIC_FAST_MODEL=claude-haiku-4-5
# Chat assistant; defaults to ANTHROPIC_FAST_MODEL
# ANTHROPIC_CHAT_MODEL=claude-haiku-4-5
# Pin "today" so scores are reproducible for the demo (PRD FR-05)
DEMO_EVAL_DATE=2026-10-25
# Secret for the scheduled enrichment refresh (/api/cron/enrich); Vercel Cron sends it automatically
# CRON_SECRET=
