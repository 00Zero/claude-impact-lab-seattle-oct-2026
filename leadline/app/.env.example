# Copy this file to .env (same folder) and paste your keys after the = signs.
# .env is never uploaded to GitHub. Never put keys anywhere else.

# Finds businesses on Google Maps. Leave empty to use the free OpenStreetMap mode.
GOOGLE_MAPS_API_KEY=

# Finds businesses on TomTom (free, 2,500 searches a month). Used when there's no Google key.
TOMTOM_API_KEY=

# Lets Claude read websites, judge fit and write emails. Leave empty for template emails.
ANTHROPIC_API_KEY=

# Optional
# CLAUDE_MODEL=claude-sonnet-5-5
# SEARCHES_PER_HOUR=20
