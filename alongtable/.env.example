# Copy to .env.local and fill in. Do not put real values in this file.
# Supabase dashboard → Project Settings → API

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
SUPABASE_URL=

# Secret key (sb_secret_...) or legacy service_role key. Server-only: full database access.
SUPABASE_SERVICE_ROLE_KEY=

# Phase 8 (AI workflow), from console.anthropic.com → API Keys
# ANTHROPIC_API_KEY=
