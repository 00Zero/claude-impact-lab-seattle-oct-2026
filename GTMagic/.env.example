# Copy to .env for local development. Never commit .env.
# Every new variable gets a comment here (append only). Validated with Zod at boot.

# Claude API key: use the DEV key locally; the host gets the DEMO key. Both need spend limits.
ANTHROPIC_API_KEY=

# Model per step (see docs/TECH_STACK.md → Models)
MODEL_INTAKE=claude-haiku-5-5
MODEL_RESEARCH=claude-opus-5-5
MODEL_POSITIONING=claude-opus-5-5
MODEL_SIMULATION=claude-haiku-5-5
MODEL_ROBUSTNESS=claude-opus-5-5   # stretch: re-check a 10-customer subset on a different model
MODEL_REPORT=claude-opus-5-5

# Cost guardrails (USD); include web-search fees
RUN_BUDGET_USD=4
DAILY_BUDGET_USD=100

# Load control
LIVE_RUN_CONCURRENCY=2       # live runs at once; others queue
AI_CONCURRENCY=16            # Claude calls in flight across all runs
RUNS_PER_IP_PER_HOUR=20      # generous: judges share venue Wi-Fi
TEAM_BYPASS_TOKEN=           # sent as X-Team-Token from the team's demo device

# Audience + research sizing
AUDIENCE_SIZE=48
REPEAT_SUBSET_SIZE=10
WEB_SEARCH_MAX_USES=5

# Features
ENABLE_REFINEMENT=false      # stretch: round 2 on a holdout audience

# Data retention
RUN_RETENTION_DAYS=7

# mock | live per step (mock returns fixtures/demo/* rebound to real inputs)
STEP_MODE_INTAKE=mock
STEP_MODE_RESEARCH=mock
STEP_MODE_SAMPLE=mock
STEP_MODE_POSITION=mock
STEP_MODE_DESIGN=mock
STEP_MODE_SIMULATE=mock
STEP_MODE_EVALUATE=mock
STEP_MODE_REFINE=mock
STEP_MODE_REPORT=mock

# Tavily key for the skills' research scripts (gtm-intake scripts/tavily_log.py). On macOS it can live in the
# Keychain instead (service "gtmagic-tavily"); the script checks there when this is empty. TAVILY_NO_KEYCHAIN=1 skips that.
TAVILY_API_KEY=

# OpenRouter key for the gtm-creatives skill (GPT Sol writes draft ad wording). Deliberately not OPENROUTER_API_KEY,
# so a stray shell key is never billed. On macOS it can live in the Keychain instead (service "gtmagic-openrouter");
# the script checks there when this is empty. scripts/setup-keys.sh stores it there.
GTMAGIC_OPENROUTER_API_KEY=
