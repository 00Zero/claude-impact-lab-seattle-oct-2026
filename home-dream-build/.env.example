ANTHROPIC_API_KEY=
CHAT_MODEL=claude-sonnet-5-5
SCRIPT_MODEL=claude-opus-5-5

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=a0L48LDiuC3RCS8LXA36
ELEVENLABS_VOICE_NAME=Olena

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Path to a Google service-account JSON. Share the Drive folder and the calendar with its email.
GOOGLE_SERVICE_ACCOUNT_FILE=secrets/google-sa.json
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_CALENDAR_ID=

# Instagram Graph API (IG Business account linked to a FB Page)
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_APP_SECRET=
IG_VERIFY_TOKEN=change-me
GRAPH_API_VERSION=v23.0

# Studio: direct local Reel uploads through Facebook Login for Business.
# Link the professional Instagram account to a Page; use that Page access token.
IG_STUDIO_USER_ID=
IG_STUDIO_PAGE_ACCESS_TOKEN=
IG_STUDIO_API_VERSION=v23.0

# Public URL (ngrok) so Instagram can fetch rendered MP4s and deliver webhooks
PUBLIC_BASE_URL=https://your-domain.ngrok-free.app

# Leave unset to mock: SMS prints to console, calendar uses fake slots, IG calls are logged
AUTO_APPROVE=false
DATABASE_URL=sqlite:///data/app.db
