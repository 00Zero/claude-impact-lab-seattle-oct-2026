# Secrets (API keys; .env is also written by the studio's Voice settings panel)
.env
.env.*
!.env.example
secrets/
*.json.key

# Footage, renders and job history stay local: large and private
media/
jobs/
output/
storyboards/
data/

# Local tool settings
.claude/settings.local.json

# Python / macOS
.venv/
__pycache__/
*.pyc
.DS_Store

# Music files are licensed for use in videos, not for redistribution: keep them local.
# library.json / library.md (tempo, picks, licenses) are committed.
assets/music/*
!assets/music/library.json
!assets/music/library.md
!assets/music/README.md
