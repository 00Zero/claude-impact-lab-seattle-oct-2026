HOST=127.0.0.1
PORT=3000
DATA_DIR=./data
# No accounts or network needed for the default demo.
SEED_DEMO=true
WORKSPACE_TOKEN=
ACQUISITION_AI_PROVIDER=mock
ANTHROPIC_API_KEY=
# Use an available Claude model ID from your credit-enabled account.
ANTHROPIC_MODEL=
# Empty = follow the AI mode; claude inspects supplied or original-video frames.
# Set metadata only when deliberately disabling vision for an offline demo.
VIDEO_VISION_PROVIDER=
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

DRIVE_PROVIDER=mock
CALENDAR_PROVIDER=mock
GOOGLE_ACCESS_TOKEN=
# Prefer refresh credentials when connecting real accounts.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_ROOT_ID=
# Optional existing folder containing original reference images.
GOOGLE_DRIVE_MEDIA_FOLDER_ID=
GOOGLE_CALENDAR_ID=primary

INSTAGRAM_PROVIDER=mock
INSTAGRAM_API_VERSION=
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_APP_SECRET=
INSTAGRAM_VERIFY_TOKEN=

# Optional Facebook Login credentials, separate from the live Instagram Login provider.
# These values alone do not enable Facebook posting or switch the Instagram integration.
META_APP_ID=
META_APP_SECRET=
META_BUSINESS_ID=
FACEBOOK_PAGE_ID=
FACEBOOK_API_VERSION=
FACEBOOK_USER_ACCESS_TOKEN=
FACEBOOK_PAGE_ACCESS_TOKEN=

# mock | manual | browser_use. Real Browser Use needs its optional Python environment.
BROWSER_PROVIDER=mock
BROWSER_PYTHON=python3
BROWSER_PROFILE_DIR=
BROWSER_EXECUTABLE_PATH=

# Public HTTPS origin for scoped intake and booking pages (required for live Instagram).
PUBLIC_CUSTOMER_ORIGIN=

# Developer-only: standalone hi starts a fresh test round for these exact Instagram-scoped IDs.
# Never use a username or enable this for real customers. Disabled by default.
DEVELOPER_TEST_RESET_ENABLED=false
DEVELOPER_TEST_INSTAGRAM_IDS=

# Team notifications use a separate WhatsApp Business sender/token.
TEAM_NOTIFICATION_CHANNEL=whatsapp
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=
WHATSAPP_TEAM_RECIPIENT=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en_US
