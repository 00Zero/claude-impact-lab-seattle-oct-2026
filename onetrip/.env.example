# Copy to .env.local and fill in from Supabase dashboard → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Signs customer intake links. Generate with: openssl rand -base64 32
# Changing it invalidates every link already sent.
INTAKE_LINK_SECRET=

# Server-only secret key (Project Settings → API Keys → Secret keys). Stores
# customer photos in the private intake-photos bucket. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Public base URL for intake links (optional locally, set in production)
# SITE_URL=https://your-domain.com

# Claude API key for photo analysis, questions, and briefs (server only; never NEXT_PUBLIC_)
ANTHROPIC_API_KEY=
# Optional: pin a tested model. Defaults to claude-opus-5-5.
# ANTHROPIC_MODEL=claude-opus-5-5
# Optional AI budgets (calls per 24 hours)
# AI_WORKSPACE_DAILY_LIMIT=200
# AI_GLOBAL_DAILY_LIMIT=2000
